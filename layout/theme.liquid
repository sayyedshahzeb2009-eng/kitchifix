<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}{{ content_for_header }}{{ 'theme.css' | asset_url | stylesheet_tag }}<script src="{{ 'theme.js' | asset_url }}" defer></script>{% if settings.enable_3d %}<script type="module" src="https://unpkg.com/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>{% endif %}<style>:root{--bg:{{ settings.background_color }};--text:{{ settings.text_color }};--accent:{{ settings.accent_color }};--lime:{{ settings.accent_color_2 }};--radius:{{ settings.card_radius }}px;--max:{{ settings.container_width }}px}</style></head><body><a class="skip" href="#MainContent">Skip to content</a>{% sections 'header-group' %}<main id="MainContent">{{ content_for_layout }}</main>{% sections 'footer-group' %}<div id="Toast" class="toast"></div><div id="CartDrawer" class="drawer" aria-hidden="true"><div class="drawer-bg" data-close-cart></div><aside class="drawer-panel"><header><h2>Your cart</h2><button data-close-cart>×</button></header><div id="CartItems"></div><footer><div class="total"><span>Subtotal</span><b id="CartTotal">{{ cart.total_price | money }}</b></div><a class="btn primary full" href="{{ routes.cart_url }}">View cart & checkout</a></footer></aside></div></body></html>