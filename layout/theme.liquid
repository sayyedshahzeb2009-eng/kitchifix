<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}{{ content_for_header }}{{ 'theme.css' | asset_url | stylesheet_tag }}{{ 'luxury-overrides.css' | asset_url | stylesheet_tag }}{{ 'mobile-premium.css' | asset_url | stylesheet_tag }}{{ 'footer-premium.css' | asset_url | stylesheet_tag }}{{ 'smooth-scroll.css' | asset_url | stylesheet_tag }}<script src="{{ 'theme.js' | asset_url }}" defer></script>{% if settings.enable_3d %}<script type="module" src="https://unpkg.com/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>{% endif %}<style>:root{--bg:{{ settings.background_color }};--text:{{ settings.text_color }};--accent:{{ settings.accent_color }};--lime:{{ settings.accent_color_2 }};--radius:{{ settings.card_radius }}px;--max:{{ settings.container_width }}px}.skip{position:fixed!important;left:16px!important;top:16px!important;z-index:1000!important;transform:translateY(-180%)!important;opacity:0!important;background:#f1eee6!important;color:#111!important;padding:12px 16px!important;border-radius:10px!important;text-decoration:none!important;box-shadow:0 12px 30px #0002!important;transition:transform .2s ease,opacity .2s ease!important}.skip:focus{transform:translateY(0)!important;opacity:1!important}.kf-scroll-progress{position:fixed;left:0;top:0;width:100%;height:2px;background:rgba(52,72,61,.05);z-index:100;pointer-events:none}.kf-scroll-progress span{display:block;width:100%;height:100%;background:var(--accent,#b76e52);transform-origin:left center;transform:scaleX(var(--kf-scroll-progress,0));opacity:.65}@media(prefers-reduced-motion:reduce){.kf-scroll-progress{display:none}}</style></head><body><div class="kf-scroll-progress" aria-hidden="true"><span></span></div><a class="skip" href="#MainContent">Skip to content</a>{% sections 'header-group' %}<main id="MainContent">{{ content_for_layout }}</main>{% sections 'footer-group' %}<div id="Toast" class="toast"></div><div id="CartDrawer" class="drawer" aria-hidden="true"><div class="drawer-bg" data-close-cart></div><aside class="drawer-panel"><header><h2>Your cart</h2><button data-close-cart>×</button></header><div id="CartItems"></div><footer><div class="total"><span>Subtotal</span><b id="CartTotal">{{ cart.total_price | money }}</b></div><a class="btn primary full" href="{{ routes.cart_url }}">View cart & checkout</a></footer></aside></div>{% render 'smooth-scroll' %}<script>(function(){if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;var root=document.documentElement,raf=0;function update(){raf=0;var y=window.scrollY||window.pageYOffset||0;var max=Math.max(1,document.documentElement.scrollHeight-window.innerHeight);root.style.setProperty('--kf-scroll-progress',Math.min(1,y/max).toFixed(4))}function request(){if(!raf)raf=requestAnimationFrame(update)}window.addEventListener('scroll',request,{passive:true});window.addEventListener('resize',request,{passive:true});request()})();</script></body></html>