<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}{{ content_for_header }}{{ 'theme.css' | asset_url | stylesheet_tag }}{{ 'luxury-overrides.css' | asset_url | stylesheet_tag }}<script src="{{ 'theme.js' | asset_url }}" defer></script>{% if settings.enable_3d %}<script type="module" src="https://unpkg.com/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>{% endif %}<style>:root{--bg:{{ settings.background_color }};--text:{{ settings.text_color }};--accent:{{ settings.accent_color }};--lime:{{ settings.accent_color_2 }};--radius:{{ settings.card_radius }}px;--max:{{ settings.container_width }}px}.kf-scroll-layer{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;contain:strict}.kf-scroll-orb{position:absolute;border-radius:50%;filter:blur(1px);will-change:transform}.kf-scroll-orb.one{width:420px;height:420px;right:-180px;top:12vh;background:radial-gradient(circle,rgba(183,110,82,.10),transparent 68%)}.kf-scroll-orb.two{width:520px;height:520px;left:-260px;top:62vh;background:radial-gradient(circle,rgba(145,163,150,.13),transparent 68%)}.kf-scroll-line{position:absolute;left:50%;top:-10vh;width:1px;height:120vh;background:linear-gradient(to bottom,transparent,rgba(52,72,61,.10),transparent);transform-origin:50% 50%;will-change:transform}.kf-scroll-layer~header,.kf-scroll-layer~main,.kf-scroll-layer~footer{position:relative;z-index:1}.kf-scroll-layer~main{isolation:isolate}.kf-scroll-layer~header{z-index:20}.kf-scroll-progress{position:fixed;left:0;top:0;width:100%;height:2px;background:rgba(52,72,61,.06);z-index:100;pointer-events:none}.kf-scroll-progress span{display:block;width:100%;height:100%;background:var(--accent,#b76e52);transform-origin:left center;transform:scaleX(var(--kf-scroll-progress,0));opacity:.72}.kf-scroll-layer.kf-scrolling .kf-scroll-orb.one{filter:blur(2px)}@media(prefers-reduced-motion:reduce){.kf-scroll-layer,.kf-scroll-progress{display:none}}</style></head><body><div class="kf-scroll-layer" aria-hidden="true"><div class="kf-scroll-orb one"></div><div class="kf-scroll-orb two"></div><div class="kf-scroll-line"></div></div><div class="kf-scroll-progress" aria-hidden="true"><span></span></div><a class="skip" href="#MainContent">Skip to content</a>{% sections 'header-group' %}<main id="MainContent">{{ content_for_layout }}</main>{% sections 'footer-group' %}<div id="Toast" class="toast"></div><div id="CartDrawer" class="drawer" aria-hidden="true"><div class="drawer-bg" data-close-cart></div><aside class="drawer-panel"><header><h2>Your cart</h2><button data-close-cart>×</button></header><div id="CartItems"></div><footer><div class="total"><span>Subtotal</span><b id="CartTotal">{{ cart.total_price | money }}</b></div><a class="btn primary full" href="{{ routes.cart_url }}">View cart & checkout</a></footer></aside></div><script>(function(){if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;var layer=document.querySelector('.kf-scroll-layer'),orb1=layer&&layer.querySelector('.one'),orb2=layer&&layer.querySelector('.two'),line=layer&&layer.querySelector('.kf-scroll-line'),root=document.documentElement,raf=0;function update(){raf=0;var y=window.scrollY||window.pageYOffset||0;var max=Math.max(1,document.documentElement.scrollHeight-window.innerHeight);var p=Math.min(1,y/max);root.style.setProperty('--kf-scroll-progress',p.toFixed(4));if(orb1)orb1.style.transform='translate3d(0,'+(y*.075)+'px,0) scale('+(1+p*.035)+')';if(orb2)orb2.style.transform='translate3d(0,'+(-y*.045)+'px,0) scale('+(1+p*.025)+')';if(line)line.style.transform='translate3d('+(Math.sin(y*.002)*18)+'px,'+(y*.018)+'px,0) rotate('+(y*.012)+'deg)';if(layer)layer.classList.toggle('kf-scrolling',true);setTimeout(function(){if(layer)layer.classList.remove('kf-scrolling')},80)}function request(){if(!raf)raf=requestAnimationFrame(update)}window.addEventListener('scroll',request,{passive:true});window.addEventListener('resize',request,{passive:true});request()})();</script></body></html>