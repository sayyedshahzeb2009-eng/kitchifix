{% if product.metafields.custom.short_description != blank %}<p class="product-short">{{ product.metafields.custom.short_description }}</p>{% endif %}{% if product.metafields.custom.features != blank %}<div class="managed-features">{% assign features = product.metafields.custom.features.value %}{% if features %}{% for feature in features %}<div>✓ {{ feature }}</div>{% endfor %}{% else %}{{ product.metafields.custom.features | metafield_tag }}{% endif %}</div>{% endif %}{% if product.metafields.custom.shipping_note != blank %}<div class="shipping-note">🚚 {{ product.metafields.custom.shipping_note }}</div>{% endif %}