<article class="product-card"><a class="product-media" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width:800 | image_tag: loading:'lazy', alt:product.title }}{% else %}<div class="placeholder">K</div>{% endif %}{% render 'product-badges', product: product %}</a><div class="product-body"><div class="stars">{% if product.metafields.custom.rating != blank %}{{ product.metafields.custom.rating }}{% else %}★★★★★{% endif %} <small>{% if product.metafields.custom.review_count != blank %}({{ product.metafields.custom.review_count }}){% endif %}</small></div><h3><a href="{{ product.url }}">{{ product.title }}</a></h3>{% if product.metafields.custom.short_description != blank %}<p class="product-short">{{ product.metafields.custom.short_description }}</p>{% endif %}<div class="price"><b>{{ product.price | money }}</b>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s><span class="save">Save {{ product.compare_at_price | minus: product.price | money }}</span>{% endif %}</div>{% if product.available %}<form data-add-to-cart><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="btn dark full">Quick add</button></form>{% else %}<button class="btn disabled full" disabled>Sold out</button>{% endif %}</div></article>