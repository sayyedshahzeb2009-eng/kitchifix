<article class="product-card"><a class="product-media" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width:800 | image_tag: loading:'lazy', alt:product.title }}{% else %}<div class="placeholder kf-card-placeholder" aria-label="KitchiFix kitchen essential"><div class="kf-card-icon"><span></span><i></i><b></b></div><small>KITCHIFIX<br>ESSENTIAL</small></div>{% endif %}{% render 'product-badges', product: product %}</a><div class="product-body"><div class="stars">{% if product.metafields.custom.rating != blank %}{{ product.metafields.custom.rating }}{% else %}★★★★★{% endif %} <small>{% if product.metafields.custom.review_count != blank %}({{ product.metafields.custom.review_count }}){% endif %}</small></div><h3><a href="{{ product.url }}">{{ product.title }}</a></h3>{% if product.metafields.custom.short_description != blank %}<p class="product-short">{{ product.metafields.custom.short_description }}</p>{% endif %}<div class="price"><b>{{ product.price | money }}</b>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s><span class="save">Save {{ product.compare_at_price | minus: product.price | money }}</span>{% endif %}</div>{% if product.available %}<form data-add-to-cart><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="btn dark full">Quick add</button></form>{% else %}<button class="btn disabled full" disabled>Sold out</button>{% endif %}</div></article>
<style>
.kf-card-placeholder{position:relative;width:100%;height:100%;display:grid;place-items:center;background:radial-gradient(circle at 50% 35%,#f7f5ef,#e4e1d7 62%,#d6d2c7);overflow:hidden}.kf-card-placeholder:before{content:"";position:absolute;width:68%;height:68%;border:1px solid rgba(44,49,43,.11);border-radius:50%;transform:rotate(20deg)}.kf-card-placeholder:after{content:"";position:absolute;width:42%;height:42%;border:1px solid rgba(166,140,98,.18);border-radius:50%;transform:rotate(-28deg)}.kf-card-icon{position:relative;z-index:2;width:92px;height:92px;border-radius:28px;background:linear-gradient(145deg,#30362f,#171b18);box-shadow:0 22px 35px rgba(20,25,21,.2);transform:rotate(-6deg);display:grid;place-items:center}.kf-card-icon span{width:42px;height:42px;border-radius:50%;border:2px solid #b8a276;box-shadow:inset 0 0 0 6px #222823}.kf-card-icon i{position:absolute;width:22px;height:4px;border-radius:99px;background:#b8a276;transform:rotate(45deg);right:8px;top:29px}.kf-card-icon b{position:absolute;width:6px;height:6px;border-radius:50%;background:#d9d2c1;left:22px;top:20px}.kf-card-placeholder small{position:absolute;z-index:3;bottom:18px;left:0;right:0;text-align:center;color:#64675f;font-size:8px;font-weight:800;letter-spacing:.18em;line-height:1.5}.product-card:hover .kf-card-icon{transform:rotate(-2deg) translateY(-4px);transition:transform .45s ease}
</style>