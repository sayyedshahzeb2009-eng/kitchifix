<section class="kf-collections-page">
  <div class="kf-collections-hero">
    <div class="container">
      <span class="kf-collections-kicker">KITCHIFIX / COLLECTIONS</span>
      <h1>Made for the<br><em>modern kitchen.</em></h1>
      <p>Explore our curated edits of practical, beautifully considered kitchen essentials.</p>
    </div>
  </div>

  <div class="container kf-collections-body">
    <div class="kf-collections-intro">
      <span>THE KITCHIFIX EDIT</span>
      <h2>Shop by collection</h2>
    </div>
    <div class="kf-collection-grid">
      <a class="kf-collection-card kf-collection-all" href="{{ routes.all_products_collection_url }}">
        <div class="kf-collection-image"><span>ALL PRODUCTS</span></div>
        <div class="kf-collection-meta"><strong>All products</strong><span>Explore the full edit →</span></div>
      </a>
      {% for collection in collections %}
        {% unless collection.handle == 'all' %}
          <a class="kf-collection-card" href="{{ collection.url }}">
            <div class="kf-collection-image">
              {% if collection.featured_image %}
                {{ collection.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: collection.title }}
              {% else %}
                <span>{{ collection.title }}</span>
              {% endif %}
            </div>
            <div class="kf-collection-meta"><strong>{{ collection.title }}</strong><span>{{ collection.products_count }} products →</span></div>
          </a>
        {% endunless %}
      {% endfor %}
    </div>
    {% if collections.size == 0 %}<div class="kf-collections-empty"><h2>Your collections are coming together.</h2><p>Create your first Shopify collection and it will appear here automatically.</p></div>{% endif %}
  </div>
</section>

<style>
.kf-collections-page{background:#f7f5f0;color:#171716;padding-bottom:110px}.kf-collections-hero{padding:118px 0 100px;background:#171716;color:#f5f1e8;position:relative;overflow:hidden}.kf-collections-hero:after{content:"";position:absolute;width:560px;height:560px;right:-220px;top:-300px;border-radius:50%;background:radial-gradient(circle,rgba(177,142,82,.18),transparent 68%);pointer-events:none}.kf-collections-hero .container{position:relative;z-index:1}.kf-collections-kicker{font-size:10px;font-weight:700;letter-spacing:.22em;color:#c5a66d}.kf-collections-hero h1{font-size:clamp(52px,7.5vw,100px);font-weight:500;line-height:.94;letter-spacing:-.055em;margin:22px 0 28px}.kf-collections-hero em{font-family:Georgia,serif;font-weight:400;color:#c5a66d}.kf-collections-hero p{max-width:590px;color:#aaa59b;font-size:17px;line-height:1.75;margin:0}.kf-collections-body{padding-top:80px}.kf-collections-intro{display:flex;align-items:end;justify-content:space-between;border-bottom:1px solid #ddd8ce;padding-bottom:20px;margin-bottom:28px}.kf-collections-intro span{font-size:10px;letter-spacing:.18em;font-weight:700;color:#a17e43}.kf-collections-intro h2{font-size:28px;font-weight:500;margin:0}.kf-collection-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.kf-collection-card{display:block;color:inherit;text-decoration:none}.kf-collection-image{aspect-ratio:1/1.08;background:#e9e5dc;overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center}.kf-collection-image img{width:100%;height:100%;object-fit:cover;transition:transform .55s ease}.kf-collection-card:hover .kf-collection-image img{transform:scale(1.035)}.kf-collection-image span{font-size:11px;letter-spacing:.2em;color:#8c806d}.kf-collection-all .kf-collection-image{background:#1b1b19;color:#c5a66d}.kf-collection-all .kf-collection-image:before{content:"";position:absolute;inset:20px;border:1px solid rgba(197,166,109,.35)}.kf-collection-all .kf-collection-image span{color:#c5a66d;z-index:1}.kf-collection-meta{display:flex;justify-content:space-between;align-items:center;padding:18px 2px;border-bottom:1px solid #ddd8ce}.kf-collection-meta strong{font-size:17px;font-weight:500}.kf-collection-meta span{font-size:11px;color:#8c887f}.kf-collections-empty{text-align:center;padding:80px 20px;border:1px solid #ddd8ce}.kf-collections-empty h2{font-weight:500}.kf-collections-empty p{color:#77736b}@media(max-width:850px){.kf-collection-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.kf-collections-hero{padding:80px 0}.kf-collections-body{padding-top:55px}.kf-collections-intro{display:block}.kf-collections-intro h2{margin-top:10px}.kf-collection-grid{grid-template-columns:1fr}.kf-collections-page{padding-bottom:70px}}
</style>

{% schema %}{"name":"Collections index","settings":[]}{% endschema %}