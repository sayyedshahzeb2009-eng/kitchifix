<section class="kf-showcase section">
  <div class="container">
    <div class="kf-showcase-grid">
      <div class="kf-showcase-visual" data-kf-showcase>
        <div class="kf-stage-glow"></div>
        <div class="kf-stage-ring ring-a"></div>
        <div class="kf-stage-ring ring-b"></div>

        {% if settings.enable_3d and section.settings.model_url != blank %}
          <model-viewer class="kf-real-model" src="{{ section.settings.model_url }}" camera-controls auto-rotate rotation-per-second="10deg" shadow-intensity="1" exposure="1.05" alt="{{ section.settings.heading | escape }}"></model-viewer>
        {% elsif section.settings.image != blank %}
          {{ section.settings.image | image_url: width:1100 | image_tag: class:'kf-showcase-image', loading:'lazy', alt:section.settings.heading }}
        {% else %}
          <div class="kf-product-scene" aria-label="Animated KitchiFix kitchen essential">
            <div class="kf-product-shadow"></div>
            <div class="kf-canister">
              <div class="kf-lid"><i></i></div>
              <div class="kf-body"><span>KITCHIFIX</span><small>ESSENTIAL</small></div>
              <div class="kf-window"></div>
              <div class="kf-base"></div>
            </div>
            <div class="kf-spout"><b></b></div>
            <div class="kf-drop d1"></div>
            <div class="kf-drop d2"></div>
            <div class="kf-mini-card">SMART<br><strong>ESSENTIAL</strong></div>
          </div>
        {% endif %}

        <div class="kf-showcase-badge"><span>360°</span><small>Interactive product</small></div>
      </div>

      <div class="kf-showcase-copy">
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>

        <div class="kf-feature-list">
          {% for block in section.blocks %}
            <div class="kf-feature" {{ block.shopify_attributes }}>
              <span class="kf-feature-number">0{{ forloop.index }}</span>
              <span class="kf-feature-check">✓</span>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.link != blank %}
          <a class="btn primary large" href="{{ section.settings.link }}">{{ section.settings.button }} <span>→</span></a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.kf-showcase{overflow:hidden;background:#f0ede5;padding:110px 0}.kf-showcase-grid{display:grid;grid-template-columns:1.12fr .88fr;align-items:center;gap:90px}.kf-showcase-visual{position:relative;min-height:620px;display:grid;place-items:center;perspective:1200px;transform-style:preserve-3d}.kf-stage-glow{position:absolute;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,#dce1d9 0%,#e8e6df 46%,transparent 69%);opacity:.95}.kf-stage-ring{position:absolute;border:1px solid rgba(46,52,47,.12);border-radius:50%;pointer-events:none}.ring-a{width:570px;height:570px;transform:rotateX(66deg) rotateZ(-12deg);animation:kfRing 16s linear infinite}.ring-b{width:430px;height:430px;transform:rotateY(66deg) rotateZ(20deg);border-color:rgba(170,142,94,.18);animation:kfRingReverse 20s linear infinite}.kf-real-model{width:100%;height:600px;position:relative;z-index:4}.kf-showcase-image{position:relative;z-index:4;width:min(540px,88%);max-height:560px;object-fit:contain;filter:drop-shadow(0 35px 35px rgba(20,24,21,.16))}.kf-product-scene{position:relative;z-index:4;width:430px;height:520px;transform-style:preserve-3d;animation:kfProductFloat 5.5s ease-in-out infinite}.kf-product-shadow{position:absolute;left:50%;bottom:34px;width:285px;height:55px;border-radius:50%;background:rgba(22,27,23,.16);filter:blur(18px);transform:translateX(-50%);animation:kfShadow 5.5s ease-in-out infinite}.kf-canister{position:absolute;left:50%;top:94px;width:210px;height:325px;transform:translateX(-50%) rotateY(-18deg) rotateX(5deg);transform-style:preserve-3d;filter:drop-shadow(25px 30px 25px rgba(25,29,25,.17))}.kf-body{position:absolute;left:15px;right:15px;top:48px;height:235px;border-radius:48px 48px 42px 42px;background:linear-gradient(100deg,#aeb5ad 0%,#eef0e9 28%,#cdd2c9 55%,#858d84 100%);box-shadow:inset 15px 0 18px rgba(255,255,255,.35),inset -18px 0 25px rgba(30,35,30,.15);overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center}.kf-body:before{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.32) 43%,transparent 54%);animation:kfShine 4s ease-in-out infinite}.kf-body span{position:relative;color:#26302a;font-size:17px;font-weight:800;letter-spacing:.18em}.kf-body small{position:relative;margin-top:9px;color:#747970;font-size:8px;font-weight:700;letter-spacing:.25em}.kf-window{position:absolute;z-index:2;left:42px;right:42px;bottom:34px;height:52px;border:1px solid rgba(40,46,40,.12);border-radius:8px;background:linear-gradient(180deg,rgba(246,247,241,.62),rgba(157,166,156,.35));box-shadow:inset 0 5px 10px rgba(255,255,255,.28)}.kf-base{position:absolute;left:28px;right:28px;bottom:0;height:48px;border-radius:15px 15px 25px 25px;background:linear-gradient(100deg,#252c27,#596159,#202621);box-shadow:0 13px 16px rgba(0,0,0,.16)}.kf-lid{position:absolute;z-index:4;left:29px;top:13px;width:152px;height:75px;border-radius:50%;background:linear-gradient(140deg,#e9e8e1,#7e877d 75%);transform:rotateX(57deg);box-shadow:0 10px 12px rgba(0,0,0,.14)}.kf-lid:after{content:"";position:absolute;left:53px;top:25px;width:48px;height:19px;border-radius:50%;background:#252c27}.kf-lid i{position:absolute;left:68px;top:20px;width:18px;height:10px;border-radius:50%;background:#b5a178}.kf-spout{position:absolute;z-index:5;right:51px;top:94px;width:84px;height:22px;border-radius:99px;background:linear-gradient(#252c27,#5c665c);transform:rotate(-24deg);box-shadow:0 7px 10px rgba(0,0,0,.12)}.kf-spout:after{content:"";position:absolute;right:-7px;top:2px;width:18px;height:18px;border-radius:50%;background:#252c27}.kf-spout b{position:absolute;right:-3px;top:15px;width:5px;height:16px;border-radius:50%;background:#bca16b;animation:kfDrop 2.6s ease-in infinite}.kf-drop{position:absolute;z-index:8;width:7px;height:11px;border-radius:70% 30% 70% 30%;background:#bca16b;opacity:0}.d1{right:37px;top:132px;animation:kfDropFall 3.1s 1s ease-in infinite}.d2{right:49px;top:138px;animation:kfDropFall 3.1s 2.1s ease-in infinite}.kf-mini-card{position:absolute;z-index:10;right:-15px;bottom:100px;padding:14px 17px;background:rgba(255,255,255,.9);border:1px solid rgba(30,34,30,.08);border-radius:12px;box-shadow:0 15px 30px rgba(30,35,30,.11);color:#252b26;font-size:8px;line-height:1.5;letter-spacing:.08em;transform:rotate(4deg);animation:kfCardFloat 4.5s ease-in-out infinite}.kf-mini-card strong{font-size:10px;letter-spacing:.12em}.kf-showcase-badge{position:absolute;z-index:12;left:12%;bottom:70px;display:flex;align-items:center;gap:12px;padding:12px 17px;background:#fff;border:1px solid rgba(25,28,25,.08);border-radius:99px;box-shadow:0 15px 30px rgba(25,28,25,.09)}.kf-showcase-badge span{font-size:11px;font-weight:800;color:#a88c5c}.kf-showcase-badge small{font-size:10px;color:#777970}.kf-showcase-copy .eyebrow{margin-bottom:20px}.kf-showcase-copy h2{max-width:650px;font-size:clamp(38px,4.4vw,62px);line-height:1.02;letter-spacing:-.045em;margin:0 0 24px;color:#20231f}.kf-showcase-copy>p{max-width:590px;color:#6f736b;font-size:17px;line-height:1.8;margin:0 0 30px}.kf-feature-list{border-top:1px solid rgba(25,29,25,.1);margin-bottom:32px}.kf-feature{display:grid;grid-template-columns:38px 28px 1fr;align-items:center;min-height:61px;border-bottom:1px solid rgba(25,29,25,.1);color:#2c312c;font-size:14px}.kf-feature-number{font-size:10px;font-weight:700;color:#a58a5b}.kf-feature-check{width:21px;height:21px;border-radius:50%;display:grid;place-items:center;background:#29322c;color:#e9e4d8;font-size:11px}.kf-feature span:last-child{font-weight:600}.kf-showcase .btn span{margin-left:16px}.kf-product-scene:hover{animation-play-state:paused}.kf-product-scene:hover .kf-canister{transform:translateX(-50%) rotateY(35deg) rotateX(8deg) rotateZ(-2deg);transition:transform .8s cubic-bezier(.2,.8,.2,1)}@keyframes kfProductFloat{0%,100%{transform:translate3d(0,0,0) rotateY(-3deg)}50%{transform:translate3d(0,-12px,0) rotateY(4deg)}}@keyframes kfShadow{0%,100%{transform:translateX(-50%) scale(1);opacity:.16}50%{transform:translateX(-50%) scale(.88);opacity:.1}}@keyframes kfCardFloat{0%,100%{transform:translate3d(0,0,0) rotate(4deg)}50%{transform:translate3d(0,-10px,0) rotate(2deg)}}@keyframes kfRing{to{transform:rotateX(66deg) rotateZ(348deg)}}@keyframes kfRingReverse{to{transform:rotateY(66deg) rotateZ(-340deg)}}@keyframes kfShine{0%,100%{transform:translateX(-100%)}45%,65%{transform:translateX(100%)}}@keyframes kfDrop{0%,75%,100%{transform:translateY(0);opacity:0}15%,55%{opacity:1}70%{transform:translateY(12px);opacity:0}}@keyframes kfDropFall{0%{transform:translateY(0) scale(.7);opacity:0}15%{opacity:1}100%{transform:translateY(80px) scale(1.1);opacity:0}}@media(max-width:900px){.kf-showcase{padding:80px 0}.kf-showcase-grid{grid-template-columns:1fr;gap:45px}.kf-showcase-visual{min-height:500px}.kf-showcase-copy{max-width:720px;margin:auto}.kf-real-model{height:500px}}@media(max-width:600px){.kf-showcase-visual{min-height:440px}.kf-stage-glow{width:390px;height:390px}.ring-a{width:400px;height:400px}.ring-b{width:310px;height:310px}.kf-product-scene{transform:scale(.78)}.kf-showcase-badge{left:4%;bottom:40px}.kf-showcase-copy h2{font-size:38px}.kf-showcase-copy>p{font-size:15px}.kf-feature{min-height:56px}}@media(prefers-reduced-motion:reduce){.kf-product-scene,.kf-product-shadow,.kf-mini-card,.kf-stage-ring,.kf-body:before,.kf-drop,.kf-spout b{animation:none!important}.kf-product-scene:hover .kf-canister{transform:translateX(-50%) rotateY(-18deg) rotateX(5deg)}}
</style>

{% schema %}
{"name":"3D product showcase","max_blocks":5,"blocks":[{"type":"feature","name":"Feature","settings":[{"type":"text","id":"text","label":"Feature","default":"Built for everyday use"}]}],"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE KITCHIFIX DIFFERENCE"},{"type":"text","id":"heading","label":"Heading","default":"A smarter little upgrade for your everyday kitchen."},{"type":"textarea","id":"text","label":"Text","default":"Meet a beautifully presented kitchen essential designed to make everyday routines simpler, cleaner and more effortless."},{"type":"image_picker","id":"image","label":"Product image"},{"type":"url","id":"model_url","label":"3D model URL (.glb / .gltf)"},{"type":"text","id":"button","label":"Button","default":"Explore the collection"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"3D product showcase","blocks":[{"type":"feature","settings":{"text":"Practical for everyday kitchen routines"}},{"type":"feature","settings":{"text":"Premium, space-conscious design"}},{"type":"feature","settings":{"text":"Simple to use and easy to love"}}]}]}
{% endschema %}