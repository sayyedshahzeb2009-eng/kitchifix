<section class="section"><div class="container showcase"><div class="showcase-visual" data-tilt>{% if settings.enable_3d and section.settings.model_url != blank %}<model-viewer src="{{ section.settings.model_url }}" camera-controls auto-rotate rotation-per-second="-12deg" shadow-intensity="1" alt="{{ section.settings.heading | escape }}"></model-viewer>{% elsif section.settings.image != blank %}{{ section.settings.image | image_url: width:1100 | image_tag: loading:'lazy', alt:section.settings.heading }}{% else %}<div class="showcase-orb">K</div>{% endif %}</div><div class="showcase-copy"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><ul>{% for block in section.blocks %}<li {{ block.shopify_attributes }}>✓ {{ block.settings.text }}</li>{% endfor %}</ul>{% if section.settings.link != blank %}<a class="btn primary large" href="{{ section.settings.link }}">{{ section.settings.button }}</a>{% endif %}</div></div></section>{% schema %}{"name":"3D product showcase","max_blocks":5,"blocks":[{"type":"feature","name":"Feature","settings":[{"type":"text","id":"text","label":"Feature","default":"Built for everyday use"}]}],"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE KITCHIFIX DIFFERENCE"},{"type":"text","id":"heading","label":"Heading","default":"Designed to solve the little problems you notice every day."},{"type":"textarea","id":"text","label":"Text","default":"Clever products that make cooking, cleaning and organizing feel effortless."},{"type":"image_picker","id":"image","label":"Fallback image"},{"type":"url","id":"model_url","label":"3D model URL"},{"type":"text","id":"button","label":"Button","default":"Explore the collection"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"3D product showcase","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]}{% endschema %}