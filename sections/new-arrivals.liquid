<section class="kf-new-arrivals section"><div class="container"><div class="kf-na-head"><div><div class="eyebrow">JUST IN • KITCHIFIX</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><a class="kf-na-link" href="{{ routes.all_products_collection_url }}?sort_by=created-descending">View all new arrivals <span>→</span></a></div><div class="product-grid">{% assign products_sorted = collections.all.products | sort: 'created_at' | reverse %}{% for product in products_sorted limit:section.settings.limit %}{% render 'product-card', product:product %}{% endfor %}</div></div></section><style>.kf-new-arrivals{position:relative;background:linear-gradient(180deg,#11110f 0%,#0b0b0a 100%);overflow:hidden}.kf-new-arrivals:before{content:"";position:absolute;right:-180px;top:-180px;width:480px;height:480px;background:radial-gradient(circle,rgba(190,158,91,.11),transparent 68%);pointer-events:none}.kf-na-head{position:relative;display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:38px}.kf-na-head h2{margin:8px 0 10px;font-size:clamp(34px,4vw,54px);letter-spacing:-.035em}.kf-na-head p{margin:0;color:rgba(255,255,255,.58);max-width:560px;line-height:1.7}.kf-na-link{white-space:nowrap;color:#c4a86f;text-decoration:none;font-size:13px;letter-spacing:.04em;border-bottom:1px solid rgba(196,168,111,.4);padding-bottom:7px;transition:.25s}.kf-na-link:hover{border-color:#c4a86f;transform:translateY(-2px)}.kf-na-link span{margin-left:12px;font-size:17px}@media(max-width:700px){.kf-na-head{align-items:start;flex-direction:column}.kf-na-link{margin-top:4px}}
</style>{% schema %}{"name":"New arrivals","settings":[{"type":"text","id":"heading","label":"Heading","default":"Fresh arrivals"},{"type":"textarea","id":"text","label":"Text","default":"Discover the latest KitchiFix essentials, selected to bring a smarter, cleaner feel to your kitchen."},{"type":"range","id":"limit","label":"Products","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"New arrivals"}]}{% endschema %}