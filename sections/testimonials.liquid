<section class="section reviews-luxury"><div class="container"><div class="reviews-intro"><div><div class="eyebrow">THE KITCHIFIX JOURNAL</div><h2>{{ section.settings.heading }}</h2></div><div class="reviews-score"><strong>{{ section.settings.rating }}</strong><span>★★★★★</span><small>{{ section.settings.subheading }}</small></div></div><div class="reviews luxury-reviews">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><div class="review-top"><span class="stars">★★★★★</span><span class="verified">{{ block.settings.label }}</span></div><blockquote>“{{ block.settings.quote }}”</blockquote><div class="review-author"><div class="review-avatar">{{ block.settings.name | slice: 0, 1 | upcase }}</div><div><b>{{ block.settings.name }}</b><small>{{ block.settings.meta }}</small></div></div></article>{% endfor %}</div></div></section><style>.reviews-luxury{background:linear-gradient(180deg,#0b0b09,#11100d);position:relative;overflow:hidden}.reviews-luxury:before{content:"";position:absolute;width:520px;height:520px;right:-220px;top:-220px;border-radius:50%;background:radial-gradient(circle,rgba(184,162,122,.13),transparent 68%);pointer-events:none}.reviews-intro{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:42px}.reviews-intro h2{max-width:720px;margin-bottom:0}.reviews-score{text-align:right;min-width:150px}.reviews-score strong{display:block;font-size:38px;letter-spacing:-.05em;color:#eee9de}.reviews-score span{display:block;color:#b8a27a;letter-spacing:4px;font-size:12px}.reviews-score small{display:block;color:#7f796e;margin-top:4px;font-size:10px}.luxury-reviews{grid-template-columns:repeat(3,1fr)}.luxury-reviews article{position:relative;background:linear-gradient(145deg,#181713,#11110e);border:1px solid rgba(184,162,122,.16);border-radius:24px;padding:30px;min-height:290px;transition:transform .35s,border-color .35s,box-shadow .35s}.luxury-reviews article:hover{transform:translateY(-8px);border-color:rgba(184,162,122,.4);box-shadow:0 25px 70px #0008}.review-top{display:flex;justify-content:space-between;align-items:center}.luxury-reviews .stars{color:#b8a27a}.verified{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:#777267;border:1px solid rgba(233,226,210,.1);border-radius:999px;padding:5px 8px}.luxury-reviews blockquote{font-size:20px;line-height:1.4;color:#ded8cc;margin:34px 0}.review-author{display:flex;align-items:center;gap:10px}.review-avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#b8a27a,#5e5545);color:#0b0b09;font-weight:900;font-size:12px}.review-author b,.review-author small{display:block}.review-author b{font-size:12px;color:#eee9de}.review-author small{font-size:10px;color:#777267;margin-top:2px}@media(max-width:720px){.reviews-intro{align-items:start;flex-direction:column}.reviews-score{text-align:left}.luxury-reviews{grid-template-columns:1fr}.luxury-reviews article{min-height:250px}}</style>{% schema %}{"name":"Luxury Testimonials","max_blocks":6,"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote","default":"The product feels beautifully considered and has made my daily kitchen routine much easier."},{"type":"text","id":"name","label":"Name","default":"Aarav"},{"type":"text","id":"meta","label":"Meta","default":"Verified KitchiFix customer"},{"type":"text","id":"label","label":"Label","default":"Verified purchase"}]}],"settings":[{"type":"text","id":"heading","label":"Heading","default":"Loved by people who care about the details."},{"type":"text","id":"rating","label":"Overall rating","default":"4.9"},{"type":"text","id":"subheading","label":"Rating note","default":"From 1,000+ customer experiences"}],"presets":[{"name":"Luxury Testimonials","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}{% endschema %}