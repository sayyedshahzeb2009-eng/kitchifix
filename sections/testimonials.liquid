<section class="section reviews-luxury" aria-label="Customer testimonials">
  <div class="container">
    <div class="reviews-intro">
      <div>
        <div class="eyebrow">THE KITCHIFIX JOURNAL</div>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="reviews-score">
        <strong>{{ section.settings.rating }}</strong>
        <span aria-label="5 out of 5 stars">★★★★★</span>
        <small>{{ section.settings.subheading }}</small>
      </div>
    </div>

    <div class="reviews luxury-reviews">
      {% for block in section.blocks %}
        <article {{ block.shopify_attributes }}>
          <div class="review-top">
            <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
            <span class="verified">{{ block.settings.label }}</span>
          </div>
          <blockquote>“{{ block.settings.quote }}”</blockquote>
          <div class="review-author">
            <div class="review-avatar" aria-hidden="true">{{ block.settings.name | slice: 0, 1 | upcase }}</div>
            <div>
              <b>{{ block.settings.name }}</b>
              <small>{{ block.settings.meta }}</small>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .reviews-luxury{background:linear-gradient(180deg,#0b0b09 0%,#11100d 100%);position:relative;overflow:hidden;color:#eee9de}
  .reviews-luxury:before{content:"";position:absolute;width:520px;height:520px;right:-220px;top:-220px;border-radius:50%;background:radial-gradient(circle,rgba(184,162,122,.14),transparent 68%);pointer-events:none}
  .reviews-luxury .container{position:relative;z-index:1}
  .reviews-intro{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:42px}
  .reviews-intro h2{max-width:720px;margin-bottom:0;color:#eee9de!important}
  .reviews-score{text-align:right;min-width:180px}
  .reviews-score strong{display:block;font-size:42px;line-height:1;letter-spacing:-.05em;color:#eee9de}
  .reviews-score span{display:block;color:#b8a27a;letter-spacing:4px;font-size:13px;margin-top:8px}
  .reviews-score small{display:block;color:#918b7e;margin-top:7px;font-size:11px}
  .luxury-reviews{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:stretch}
  .luxury-reviews article{position:relative;display:flex;flex-direction:column;background:linear-gradient(145deg,#1b1a16,#11110e)!important;border:1px solid rgba(184,162,122,.2);border-radius:24px;padding:30px;min-height:300px;color:#eee9de;opacity:1!important;visibility:visible!important;transform:none;transition:transform .35s,border-color .35s,box-shadow .35s}
  .luxury-reviews article:hover{transform:translateY(-8px);border-color:rgba(184,162,122,.48);box-shadow:0 25px 70px rgba(0,0,0,.45)}
  .review-top{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .luxury-reviews .stars{color:#b8a27a;font-size:12px;letter-spacing:3px}
  .verified{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:#bdb5a6;border:1px solid rgba(233,226,210,.14);border-radius:999px;padding:6px 9px;white-space:nowrap}
  .luxury-reviews blockquote{font-size:20px;line-height:1.45;color:#ded8cc;margin:34px 0;flex:1}
  .review-author{display:flex;align-items:center;gap:10px;margin-top:auto}
  .review-avatar{width:38px;height:38px;flex:0 0 38px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#c9b17e,#665a46);color:#0b0b09;font-weight:900;font-size:12px}
  .review-author b,.review-author small{display:block}
  .review-author b{font-size:12px;color:#eee9de}
  .review-author small{font-size:10px;color:#918b7e;margin-top:2px}
  @media(max-width:900px){.luxury-reviews{grid-template-columns:1fr 1fr!important}}
  @media(max-width:720px){.reviews-intro{align-items:start;flex-direction:column}.reviews-score{text-align:left}.luxury-reviews{grid-template-columns:1fr!important}.luxury-reviews article{min-height:260px;padding:24px}.luxury-reviews blockquote{font-size:18px}}
</style>

{% schema %}
{"name":"Luxury Testimonials","max_blocks":6,"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote","default":"The product feels beautifully considered and has made my daily kitchen routine much easier."},{"type":"text","id":"name","label":"Name","default":"Aarav"},{"type":"text","id":"meta","label":"Meta","default":"Verified KitchiFix customer"},{"type":"text","id":"label","label":"Label","default":"Verified purchase"}]}],"settings":[{"type":"text","id":"heading","label":"Heading","default":"Loved by people who care about the details."},{"type":"text","id":"rating","label":"Overall rating","default":"4.9"},{"type":"text","id":"subheading","label":"Rating note","default":"From 1,000+ customer experiences"}],"presets":[{"name":"Luxury Testimonials","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}
{% endschema %}