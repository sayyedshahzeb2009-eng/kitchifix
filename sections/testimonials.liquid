<section class="section"><div class="container"><div class="eyebrow">REAL PEOPLE. REAL KITCHENS.</div><h2>{{ section.settings.heading }}</h2><div class="reviews">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><div class="stars">★★★★★</div><blockquote>“{{ block.settings.quote }}”</blockquote><b>{{ block.settings.name }}</b><small>{{ block.settings.meta }}</small></article>{% endfor %}</div></div></section>{% schema %}{"name":"Testimonials","max_blocks":6,"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote","default":"This little kitchen upgrade is genuinely one of the most useful things I bought this year."},{"type":"text","id":"name","label":"Name","default":"Aarav"},{"type":"text","id":"meta","label":"Meta","default":"Verified customer"}]}],"settings":[{"type":"text","id":"heading","label":"Heading","default":"People are fixing their kitchens with KitchiFix."}],"presets":[{"name":"Testimonials","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}{% endschema %}