{% assign source_collection = collections[section.settings.collection_handle] %}
{% if source_collection == blank %}{% assign source_collection = collections.all %}{% endif %}
<section class="brand-collection-page">
  <div class="brand-page-hero">
    <div class="container brand-page-hero-inner">
      <span class="brand-kicker">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <div class="brand-page-rule"></div>
    </div>
  </div>
  <div class="container brand-products-wrap">
    <div class="brand-products-top"><span>{{ source_collection.products_count }} products</span><span>Curated by KitchiFix</span></div>
    <div class="product-grid brand-products-grid">
      {% assign sorted_products = source_collection.products %}
      {% if section.settings.sort == 'created-descending' %}{% assign sorted_products = source_collection.products | sort: 'created_at' | reverse %}{% endif %}
      {% for product in sorted_products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}
    </div>
    {% if source_collection.products_count == 0 %}<div class="brand-empty"><h2>Coming soon</h2><p>Our next KitchiFix edit is being prepared.</p></div>{% endif %}
  </div>
</section>
<style>
.brand-collection-page{background:#f7f5f0;color:#171716;min-height:70vh;padding-bottom:110px}.brand-page-hero{padding:118px 0 88px;text-align:center;background:#171716;color:#f5f1e8;position:relative;overflow:hidden}.brand-page-hero:after{content:"";position:absolute;width:600px;height:600px;right:-260px;top:-330px;border-radius:50%;background:radial-gradient(circle,rgba(176,141,87,.2),transparent 68%);pointer-events:none}.brand-page-hero-inner{max-width:850px;position:relative;z-index:1}.brand-kicker{display:inline-block;color:#c5a66d;font-size:10px;font-weight:800;letter-spacing:.24em;text-transform:uppercase;margin-bottom:22px}.brand-page-hero h1{font-size:clamp(52px,8vw,104px);line-height:.9;letter-spacing:-.07em;margin:0 0 24px;color:#f4f0e7;font-weight:500}.brand-page-hero p{max-width:620px;margin:auto;color:#aaa59b;font-size:17px;line-height:1.75}.brand-page-rule{width:64px;height:1px;background:#b08d57;margin:34px auto 0}.brand-products-wrap{padding-top:34px}.brand-products-top{display:flex;justify-content:space-between;border-bottom:1px solid #ded9d0;padding:0 0 18px;margin-bottom:24px;color:#77736c;font-size:10px;text-transform:uppercase;letter-spacing:.15em}.brand-products-grid{gap:20px}.brand-products-grid .product-card{background:#fff;border:1px solid #e3ded5;border-radius:14px;overflow:hidden;box-shadow:0 8px 30px rgba(23,23,22,.045)}.brand-products-grid .product-body{background:#fff;color:#171716}.brand-products-grid .product-short{color:#77736c}.brand-products-grid .product-media{background:#eeeae2}.brand-empty{text-align:center;padding:100px 20px;border:1px solid #ddd8ce}.brand-empty h2{font-size:42px;font-weight:500}.brand-empty p{color:#77736c}@media(max-width:720px){.brand-page-hero{padding:82px 0 62px}.brand-page-hero p{font-size:15px}.brand-products-top{font-size:9px}.brand-collection-page{padding-bottom:70px}}
</style>
{% schema %}{"name":"Brand collection page","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE KITCHIFIX EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Best Sellers"},{"type":"textarea","id":"subheading","label":"Subheading","default":"The kitchen upgrades customers keep coming back for."},{"type":"collection","id":"collection_handle","label":"Product collection"},{"type":"select","id":"sort","label":"Product order","options":[{"value":"best-selling","label":"Best selling"},{"value":"created-descending","label":"Newest first"}],"default":"best-selling"},{"type":"range","id":"limit","label":"Products","min":4,"max":24,"step":4,"default":24}],"presets":[{"name":"Brand collection page"}]}{% endschema %}