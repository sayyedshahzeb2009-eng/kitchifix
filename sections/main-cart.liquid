<section class="section"><div class="container cart-page"><div class="eyebrow">YOUR ORDER</div><h1>Cart</h1>{% if cart.item_count == 0 %}<div class="empty"><h2>Your cart is waiting for something clever.</h2><a class="btn primary" href="/collections/all">Shop products</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{{ item.image | image_url: width:220 | image_tag: loading:'lazy', alt:item.product.title }}</a><div><h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3><p>{{ item.final_price | money }}</p><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}<div class="cart-summary"><b>Subtotal {{ cart.total_price | money }}</b><button class="btn ghost" name="update">Update</button><button class="btn primary" name="checkout">Checkout</button></div></form>{% endif %}</div></section>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}