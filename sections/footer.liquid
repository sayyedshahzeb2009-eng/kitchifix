<footer class="kf-footer">
  <div class="kf-footer__inner">
    <div class="kf-footer__main">
      <a class="kf-footer__brand" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name }} home">
        <span class="kf-footer__mark">K</span>
        <span>{{ settings.brand_name }}</span>
      </a>
      <p>{{ settings.brand_tagline }}</p>
    </div>

    <nav class="kf-footer__links" aria-label="Footer navigation">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.collections_url }}">Collections</a>
      <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New Arrivals</a>
      <a href="{{ routes.cart_url }}">Cart</a>
    </nav>

    <div class="kf-footer__social">
      {% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
      {% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
      {% if section.settings.tiktok != blank %}<a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a>{% endif %}
    </div>
  </div>

  <div class="kf-footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ settings.brand_name }}.</span>
    <span>Thoughtful tools. Beautifully simple.</span>
  </div>
</footer>

<style>
.kf-footer{
  background:#11110f;
  color:#f1eee6;
  padding:38px 0 18px;
  border-top:1px solid rgba(255,255,255,.07)
}
.kf-footer__inner{
  max-width:1180px;
  margin:0 auto;
  padding:0 28px 30px;
  display:grid;
  grid-template-columns:1.4fr 1fr auto;
  align-items:center;
  gap:55px;
  border-bottom:1px solid rgba(255,255,255,.08)
}
.kf-footer__brand{
  display:inline-flex;
  align-items:center;
  gap:10px;
  color:#f1eee6;
  text-decoration:none;
  font-size:18px;
  font-weight:650;
  letter-spacing:-.02em
}
.kf-footer__mark{
  width:30px;
  height:30px;
  display:grid;
  place-items:center;
  border:1px solid rgba(188,161,107,.55);
  color:#c0a66f;
  font-size:14px;
  font-weight:700
}
.kf-footer__main p{
  margin:10px 0 0;
  color:#77756d;
  font-size:12px;
  line-height:1.5
}
.kf-footer__links,
.kf-footer__social{
  display:flex;
  align-items:center;
  gap:22px;
  flex-wrap:wrap
}
.kf-footer__links a,
.kf-footer__social a{
  color:#aaa79e;
  text-decoration:none;
  font-size:11px;
  letter-spacing:.04em;
  transition:color .2s ease
}
.kf-footer__links a:hover,
.kf-footer__social a:hover{color:#c0a66f}
.kf-footer__bottom{
  max-width:1180px;
  margin:0 auto;
  padding:15px 28px 0;
  display:flex;
  justify-content:space-between;
  gap:20px;
  color:#5f5d57;
  font-size:9px;
  letter-spacing:.08em;
  text-transform:uppercase
}
@media(max-width:850px){
  .kf-footer__inner{grid-template-columns:1fr;gap:22px;padding-bottom:25px}
  .kf-footer__links,.kf-footer__social{gap:18px}
}
@media(max-width:600px){
  .kf-footer{padding:30px 0 15px}
  .kf-footer__inner{padding:0 20px 22px;gap:20px}
  .kf-footer__bottom{padding:13px 20px 0;display:block;line-height:1.8}
  .kf-footer__bottom span{display:block}
  .kf-footer__bottom span+span{margin-top:3px}
}
</style>

{% schema %}
{
  "name":"Footer",
  "settings":[
    {"type":"url","id":"instagram","label":"Instagram"},
    {"type":"url","id":"facebook","label":"Facebook"},
    {"type":"url","id":"tiktok","label":"TikTok"}
  ],
  "presets":[{"name":"Footer"}]
}
{% endschema %}