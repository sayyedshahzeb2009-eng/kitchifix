<section class="section"><div class="container"><div class="collection-head"><div class="eyebrow">KITCHIFIX SHOP</div><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</div><div class="product-grid">{% for product in collection.products %}{% render 'product-card',product:product %}{% endfor %}</div></div></section>{% schema %}{"name":"Main collection","settings":[]}{% endschema %}