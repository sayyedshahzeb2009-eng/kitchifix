<section class="kf-main-collection"><div class="kf-main-collection-hero"><div class="container"><span>COLLECTION / {{ collection.title }}</span><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p>{{ collection.description }}</p>{% else %}<p>Thoughtfully selected essentials designed to make everyday kitchen life simpler and better.</p>{% endif %}</div></div><div class="container kf-main-collection-body"><div class="kf-main-collection-top"><span>{{ collection.products_count }} products</span><a href="{{ routes.collections_url }}">Browse collections →</a></div><div class="product-grid">{% for product in collection.products %}{% render 'product-card',product:product %}{% endfor %}</div>{% if collection.products_count == 0 %}<div class="kf-empty"><h2>Nothing here yet.</h2><p>This collection is being curated. Explore another collection for now.</p><a class="btn primary" href="{{ routes.collections_url }}">Browse collections</a></div>{% endif %}</div></section>
<style>.kf-main-collection{background:#f7f5f0;color:#171716;padding-bottom:100px}.kf-main-collection-hero{background:#171716;color:#f5f1e8;padding:100px 0 78px}.kf-main-collection-hero span{color:#c5a66d;font-size:10px;font-weight:700;letter-spacing:.2em}.kf-main-collection-hero h1{font-size:clamp(48px,7vw,86px);font-weight:500;letter-spacing:-.06em;line-height:.95;margin:20px 0}.kf-main-collection-hero p{max-width:620px;color:#aaa59b;font-size:16px;line-height:1.75;margin:0}.kf-main-collection-body{padding-top:30px}.kf-main-collection-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ddd8ce;padding-bottom:18px;margin-bottom:24px;color:#77736c;font-size:10px;text-transform:uppercase;letter-spacing:.13em}.kf-main-collection-top a{color:#a17e43;text-decoration:none}.kf-main-collection .product-card{background:#fff;border:1px solid #e3ded5;border-radius:14px;overflow:hidden;box-shadow:0 8px 30px rgba(23,23,22,.045)}.kf-empty{text-align:center;padding:80px 20px;border:1px solid #ddd8ce}.kf-empty h2{font-weight:500}.kf-empty p{color:#77736c;margin-bottom:24px}@media(max-width:600px){.kf-main-collection-hero{padding:72px 0 58px}.kf-main-collection-top{font-size:9px}}
</style>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}