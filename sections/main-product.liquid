<section class="section"><div class="container product-page"><div class="gallery">{% for image in product.images %}{{ image | image_url: width:1200 | image_tag: loading:'lazy', class:'product-image', alt:product.title }}{% endfor %}{% if product.metafields.custom.model_3d_url != blank %}<div class="product-3d"><model-viewer src="{{ product.metafields.custom.model_3d_url }}" camera-controls auto-rotate rotation-per-second="14deg" shadow-intensity="1" alt="{{ product.title | escape }}"></model-viewer></div>{% endif %}</div><div class="product-info"><div class="stars">{% if product.metafields.custom.rating != blank %}{{ product.metafields.custom.rating }}{% else %}★★★★★{% endif %} <span>{% if product.metafields.custom.review_count != blank %}{{ product.metafields.custom.review_count }} reviews{% else %}Trusted by KitchiFix customers{% endif %}</span></div><h1>{{ product.title }}</h1>{% render 'product-meta', product: product %}<div class="product-price"><b>{{ product.selected_or_first_available_variant.price | money }}</b>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s><span class="save">Save {{ product.compare_at_price | minus: product.price | money }}</span>{% endif %}</div><div class="description">{{ product.description }}</div>{% form 'product', product, class:'product-form' %}{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<label>{{ option.name }}<select name="options[{{ option.name | escape }}]">{% for value in option.values %}<option value="{{ value | escape }}">{{ value }}</option>{% endfor %}</select></label>{% endfor %}{% endunless %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><label>Quantity<input type="number" name="quantity" value="1" min="1"></label><button class="btn primary large full" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>{% endform %}<div class="perks">✓ Secure checkout<br>✓ Easy returns<br>✓ Support when you need it</div></div></div></section>{% schema %}{"name":"Main product","settings":[]}{% endschema %}