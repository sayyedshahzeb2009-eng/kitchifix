<section class="section"><div class="container product-page"><div class="gallery">{% for image in product.images %}{{ image | image_url: width:1200 | image_tag: loading:'lazy', class:'product-image', alt:product.title }}{% endfor %}</div><div class="product-info"><div class="stars">★★★★★ <span>Trusted by KitchiFix customers</span></div><h1>{{ product.title }}</h1><div class="product-price"><b>{{ product.selected_or_first_available_variant.price | money }}</b>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div><div class="description">{{ product.description }}</div>{% form 'product', product, class:'product-form' %}{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<label>{{ option.name }}<select name="options[{{ option.name | escape }}]">{% for value in option.values %}<option value="{{ value | escape }}">{{ value }}</option>{% endfor %}</select></label>{% endfor %}{% endunless %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><label>Quantity<input type="number" name="quantity" value="1" min="1"></label><button class="btn primary large full" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>{% endform %}<div class="perks">✓ Secure checkout<br>✓ Easy returns<br>✓ Support when you need it</div></div></div></section>{% schema %}{"name":"Main product","settings":[]}{% endschema %}