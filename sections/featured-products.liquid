<section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">View all →</a>{% endif %}</div><div class="product-grid">{% assign c=section.settings.collection %}{% if c != blank %}{% for product in c.products limit:section.settings.limit %}{% render 'product-card',product:product %}{% endfor %}{% else %}{% for product in collections.all.products limit:section.settings.limit %}{% render 'product-card',product:product %}{% endfor %}{% endif %}</div></div></section>{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CURATED FOR YOU"},{"type":"text","id":"heading","label":"Heading","default":"Best sellers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":8,"step":1,"default":4},{"type":"url","id":"link","label":"View all link"}],"presets":[{"name":"Featured products"}]}{% endschema %}