<section class="section faq faq-luxury" aria-label="Frequently asked questions">
  <div class="container faq-grid">
    <div class="faq-intro">
      <div class="eyebrow">NEED TO KNOW</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="faq-list">
      {% for block in section.blocks %}
        <details {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span class="faq-plus" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .faq-luxury{background:#0b0b09!important;color:#eee9de}
  .faq-luxury .faq-grid{align-items:start}
  .faq-luxury .faq-intro{position:sticky;top:110px}
  .faq-luxury h2{color:#eee9de!important}
  .faq-luxury .faq-intro p{color:#918b7e}
  .faq-luxury .faq-list{border-top:1px solid rgba(233,226,210,.14)}
  .faq-luxury details{border-bottom:1px solid rgba(233,226,210,.14);padding:0}
  .faq-luxury summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:25px;padding:24px 4px;color:#eee9de!important;font-size:15px;line-height:1.4}
  .faq-luxury summary::-webkit-details-marker{display:none}
  .faq-plus{width:32px;height:32px;flex:0 0 32px;border:1px solid rgba(184,162,122,.3);border-radius:50%;display:grid;place-items:center;color:#b8a27a;font-size:20px;font-weight:300;transition:transform .25s,background .25s}
  .faq-luxury details[open] .faq-plus{transform:rotate(45deg);background:rgba(184,162,122,.1)}
  .faq-luxury .faq-answer{padding:0 55px 24px 4px;color:#918b7e;font-size:14px;line-height:1.7}
  .faq-luxury .faq-answer p{margin:0;color:inherit}
  @media(max-width:720px){.faq-luxury .faq-intro{position:static}.faq-luxury summary{padding:20px 0;font-size:14px}.faq-luxury .faq-answer{padding:0 38px 20px 0}}
</style>

{% schema %}
{"name":"FAQ","max_blocks":10,"blocks":[{"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How long does delivery take?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Delivery timing depends on your location and product. See the shipping policy for current estimates.</p>"}]}],"settings":[{"type":"text","id":"heading","label":"Heading","default":"Questions, answered."},{"type":"textarea","id":"text","label":"Text","default":"Everything you need before you order."}],"presets":[{"name":"FAQ","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]}
{% endschema %}