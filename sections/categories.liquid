<section class="section category-section"><div class="container"><div class="category-intro"><div><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div><p>{{ section.settings.text }}</p></div><div class="categories">{% for block in section.blocks %}{% assign collection = collections[block.settings.collection] %}<a class="category" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% elsif collection != blank %}{{ collection.url }}{% else %}{{ routes.collections_url }}{% endif %}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width:900 | image_tag: loading:'lazy', alt:block.settings.title }}{% elsif collection != blank and collection.featured_image != blank %}{{ collection.featured_image | image_url: width:900 | image_tag: loading:'lazy', alt:collection.title }}{% else %}<div class="category-placeholder"><span>{{ block.settings.icon }}</span></div>{% endif %}<div class="category-overlay"><small>{{ block.settings.label }}</small><strong>{{ block.settings.title }}</strong><b>Explore&nbsp; →</b></div></a>{% endfor %}</div></div></section>{% schema %}{"name":"Shop by category","max_blocks":6,"blocks":[{"type":"category","name":"Category","settings":[{"type":"text","id":"title","label":"Title","default":"Kitchen Organization"},{"type":"text","id":"label","label":"Small label","default":"SMART STORAGE"},{"type":"text","id":"icon","label":"Fallback icon","default":"✦"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Custom image"},{"type":"url","id":"link","label":"Custom link"}]}],"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP BY CATEGORY"},{"type":"text","id":"heading","label":"Heading","default":"Find your kitchen upgrade"},{"type":"textarea","id":"text","label":"Description","default":"Curated essentials for smarter storage, faster prep and a more beautiful everyday kitchen."}],"presets":[{"name":"Shop by category","blocks":[{"type":"category","settings":{"title":"Kitchen Organization","label":"SMART STORAGE","icon":"▦"}},{"type":"category","settings":{"title":"Cooking Tools","label":"PREP & COOK","icon":"✦"}},{"type":"category","settings":{"title":"Cleaning Essentials","label":"EASY CLEAN","icon":"⌁"}},{"type":"category","settings":{"title":"Space Savers","label":"SMALL SPACE","icon":"◇"}}]}]}{% endschema %}