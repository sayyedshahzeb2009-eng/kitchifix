<section class="section dark-section"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><div class="categories">{% for block in section.blocks %}<a class="category" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width:700 | image_tag: loading:'lazy', alt:block.settings.title }}{% endif %}<span>{{ block.settings.title }} <b>→</b></span></a>{% endfor %}</div></div></section>{% schema %}{"name":"Shop by category","max_blocks":6,"blocks":[{"type":"category","name":"Category","settings":[{"type":"text","id":"title","label":"Title","default":"Kitchen organization"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Shop by category","blocks":[{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}