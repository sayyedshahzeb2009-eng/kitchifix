<header class="header"><div class="container header-inner"><button class="mobile" data-mobile aria-label="Menu">☰</button><a class="logo" href="{{ routes.root_url }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 260 | image_tag: class:'logo-img', alt:settings.brand_name }}{% else %}<span class="mark">K</span>{{ settings.brand_name }}{% endif %}</a><nav data-nav><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/collections/best-sellers">Best Sellers</a><a href="/collections/new-arrivals">New Arrivals</a><a href="/pages/about">About</a></nav><div class="actions"><button data-search aria-label="Search">⌕</button><a class="cart-pill" href="{{ routes.cart_url }}" data-open-cart>Cart <span id="CartCount">{{ cart.item_count }}</span></a></div></div><div class="search" data-search-panel><form action="{{ routes.search_url }}"><input name="q" type="search" placeholder="Search kitchen finds..."><button class="btn primary">Search</button></form></div></header>{% schema %}{"name":"Header","settings":[],"presets":[{"name":"Header"}]}{% endschema %}