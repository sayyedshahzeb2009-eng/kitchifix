<header class="header" role="banner">
  <div class="container header-inner">
    <button class="mobile" data-mobile aria-label="Open navigation" aria-expanded="false" type="button">☰</button>
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name }} home">
      {% if settings.logo != blank %}{{ settings.logo | image_url: width: 260 | image_tag: class:'logo-img', alt:settings.brand_name }}{% else %}<span class="mark">K</span>{{ settings.brand_name }}{% endif %}
    </a>
    <nav data-nav aria-label="Main navigation">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.collections_url }}">Collections</a>
      <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New Arrivals</a>
    </nav>
    <div class="actions">
      <button data-search aria-label="Open search" type="button">⌕</button>
      <a class="cart-pill" href="{{ routes.cart_url }}" data-open-cart aria-label="Cart, {{ cart.item_count }} items">Cart <span id="CartCount">{{ cart.item_count }}</span></a>
    </div>
  </div>
  <div class="search" data-search-panel>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input name="q" type="search" placeholder="Search kitchen essentials..." aria-label="Search products">
      <button class="btn primary" type="submit">Search</button>
    </form>
  </div>
</header>
<style>
.header{background:rgba(247,245,240,.94);border-bottom:1px solid rgba(23,23,22,.08);backdrop-filter:blur(16px);position:relative;z-index:100}
.header nav{gap:28px}.header nav a{position:relative;padding:10px 0;color:#252420;font-size:12px;font-weight:600;letter-spacing:.025em;transition:color .25s ease}.header nav a:after{content:"";position:absolute;left:0;bottom:3px;width:0;height:1px;background:var(--accent,#b08d57);transition:width .3s ease}.header nav a:hover{color:var(--accent,#b08d57)}.header nav a:hover:after{width:100%}.header .actions button{width:42px;height:42px;border-radius:50%;transition:background .25s ease,transform .25s ease}.header .actions button:hover{background:rgba(176,141,87,.1);transform:translateY(-1px)}.header .cart-pill{border:1px solid rgba(23,23,22,.12);transition:transform .25s ease,box-shadow .25s ease}.header .cart-pill:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(23,23,22,.08)}
@media(max-width:900px){.header nav{gap:18px}.header nav a{font-size:11px}}
@media(max-width:720px){
  .header-inner{height:68px;gap:10px}.header .mobile{flex:0 0 42px;width:42px;height:42px;display:grid;place-items:center;border:1px solid rgba(23,23,22,.1);background:#fffdf9;color:#252420;border-radius:50%;font-size:0;cursor:pointer;box-shadow:0 5px 16px rgba(23,23,22,.06)}
  .header .mobile:after{content:'☰';font-size:19px;line-height:1}.header .mobile[aria-expanded="true"]:after{content:'×';font-size:25px}
  .header .logo{margin-right:auto;font-size:18px;white-space:nowrap}.header .actions{gap:5px}.header .actions button{width:38px;height:38px;font-size:20px}.header .cart-pill{padding:9px 12px;font-size:11px}
  .header nav{position:absolute;top:calc(100% + 8px);left:12px;right:12px;display:flex;flex-direction:column;gap:0;padding:8px;background:rgba(255,253,249,.98);border:1px solid rgba(23,23,22,.1);border-radius:18px;box-shadow:0 22px 60px rgba(23,23,22,.14);opacity:0;visibility:hidden;pointer-events:none;transform:translateY(-8px) scale(.985);transform-origin:top center;transition:opacity .2s ease,transform .2s ease,visibility .2s ease}
  .header nav.open{opacity:1;visibility:visible;pointer-events:auto;transform:none}.header nav a{display:block;width:100%;padding:14px 14px;color:#252420;font-size:13px;border-bottom:1px solid rgba(23,23,22,.07)}.header nav a:last-child{border-bottom:0}.header nav a:after{display:none}.header nav a:active,.header nav a:hover{background:#f0ece4;color:#252420;border-radius:10px}
  .header:has(nav.open):after{content:'';position:fixed;inset:68px 0 0;background:rgba(20,20,18,.16);backdrop-filter:blur(1px);z-index:-1;pointer-events:none}
}
</style>
{% schema %}{"name":"Header","settings":[],"presets":[{"name":"Header"}]}{% endschema %}