<header class="header" role="banner"><div class="container header-inner"><button class="mobile" data-mobile aria-label="Open navigation" aria-expanded="false" type="button">☰</button><a class="logo" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name }} home">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 260 | image_tag: class:'logo-img', alt:settings.brand_name }}{% else %}<span class="mark">K</span>{{ settings.brand_name }}{% endif %}</a><nav data-nav aria-label="Main navigation"><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="{{ routes.collections_url }}">Collections</a><a href="{{ pages['new-arrivals'].url | default: '/pages/new-arrivals' }}">New Arrivals</a><a href="{{ pages['about'].url | default: '/pages/about' }}">About</a></nav><div class="actions"><button data-search aria-label="Open search" type="button">⌕</button><a class="cart-pill" href="{{ routes.cart_url }}" data-open-cart aria-label="Cart, {{ cart.item_count }} items">Cart <span id="CartCount">{{ cart.item_count }}</span></a></div></div><div class="search" data-search-panel><form action="{{ routes.search_url }}" method="get" role="search"><input name="q" type="search" placeholder="Search kitchen finds..." aria-label="Search products"><button class="btn primary" type="submit">Search</button></form></div></header><style>.header nav a{position:relative;padding:10px 0;transition:color .25s ease,opacity .25s ease}.header nav a:after{content:"";position:absolute;left:0;bottom:3px;width:0;height:1px;background:var(--accent,#b8a27a);transition:width .3s ease}.header nav a:hover{opacity:1;color:var(--accent,#b8a27a)}.header nav a:hover:after{width:100%}.header .actions button{width:42px;height:42px;border-radius:50%;transition:background .25s ease,transform .25s ease}.header .actions button:hover{background:rgba(184,162,122,.1);transform:translateY(-1px)}.header .cart-pill{transition:transform .25s ease,box-shadow .25s ease}.header .cart-pill:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(0,0,0,.2)}@media(max-width:720px){.header-inner{height:72px;gap:12px}.header nav{top:72px;padding:14px 20px;gap:4px}.header nav a{padding:14px 4px;border-bottom:1px solid rgba(233,226,210,.08)}.header nav a:last-child{border-bottom:0}.header .logo{margin-right:auto}.header .actions{gap:4px}.header .cart-pill{padding:9px 12px}}</style>{% schema %}{"name":"Header","settings":[],"presets":[{"name":"Header"}]}{% endschema %}