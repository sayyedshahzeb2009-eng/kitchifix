<section class="hero"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p><div class="hero-buttons">{% if section.settings.primary_link != blank %}<a class="btn primary large" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}{% if section.settings.secondary_link != blank %}<a class="btn ghost large" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}</div><div class="proof">★★★★★ <span>Loved by everyday kitchen problem-solvers</span></div></div><div class="hero-visual" data-tilt><div class="glow"></div>{% if settings.enable_3d and section.settings.model_url != blank %}<model-viewer src="{{ section.settings.model_url }}" camera-controls auto-rotate rotation-per-second="18deg" shadow-intensity="1" alt="{{ section.settings.heading | escape }}"></model-viewer>{% elsif section.settings.image != blank %}{{ section.settings.image | image_url: width:1000 | image_tag: class:'hero-image', loading:'eager', alt:section.settings.heading }}{% else %}<div class="orb"><b>K</b></div>{% endif %}<span class="float a">✦ Smart design</span><span class="float b">✓ Easy to use</span></div></div></section>{% schema %}{"name":"KitchiFix 3D hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE SMART KITCHEN EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Small upgrades. A seriously better kitchen."},{"type":"textarea","id":"text","label":"Text","default":"Discover practical, clever products designed to make cooking, cleaning and organizing feel effortless."},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop best sellers"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Explore products"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"image_picker","id":"image","label":"Fallback image"},{"type":"url","id":"model_url","label":"3D model URL (.glb/.gltf)"}],"presets":[{"name":"KitchiFix 3D hero"}]}{% endschema %}