<section class="hero premium-hero"><div class="hero-noise"></div><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p><div class="hero-buttons">{% if section.settings.primary_link != blank %}<a class="btn primary large" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }} <span>↗</span></a>{% endif %}{% if section.settings.secondary_link != blank %}<a class="btn ghost large" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}</div><div class="hero-proof"><div class="proof-avatars"><i></i><i></i><i></i></div><div><strong>4.9/5</strong><span>from 1,000+ happy kitchens</span></div></div></div><div class="hero-visual" data-tilt><div class="hero-product-shadow"></div>{% if settings.enable_3d and section.settings.model_url != blank %}<model-viewer src="{{ section.settings.model_url }}" camera-controls auto-rotate rotation-per-second="12deg" shadow-intensity="1" exposure="1.1" alt="{{ section.settings.heading | escape }}"></model-viewer>{% elsif section.settings.image != blank %}{{ section.settings.image | image_url: width:1400 | image_tag: class:'hero-image', loading:'eager', alt:section.settings.heading }}{% else %}<div class="hero-product-placeholder"><span>K</span></div>{% endif %}<div class="hero-floating-card card-one"><span>✦</span><div><b>Smart essentials</b><small>Made for everyday life</small></div></div><div class="hero-floating-card card-two"><b>★★★★★</b><small>Customer favourite</small></div></div></div></section>{% schema %}{"name":"KitchiFix Premium Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"KITCHIFIX • SMART KITCHEN ESSENTIALS"},{"type":"text","id":"heading","label":"Heading","default":"Make your kitchen feel effortless."},{"type":"textarea","id":"text","label":"Text","default":"Clever everyday products, beautifully designed to save space, time and effort."},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop best sellers"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Explore collection"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"image_picker","id":"image","label":"Product hero image"},{"type":"url","id":"model_url","label":"3D product model URL (.glb/.gltf)"}],"presets":[{"name":"KitchiFix Premium Hero"}]}{% endschema %}